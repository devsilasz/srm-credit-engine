# Opcional: o compose já tem estes padrões e funciona sem um arquivo .env.
# Valores só para desenvolvimento local; nenhum é um segredo real.
DB_NAME=srm
DB_USER=srm
DB_PASSWORD=srm

# Provedor de câmbio mockado: true faz falhar; PT5S atrasa cada chamada em 5 s.
FX_MOCK_FAIL=false
FX_MOCK_DELAY=PT0S
